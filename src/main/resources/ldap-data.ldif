dn: uid=space cadet,ou=space cadets,dc=springframework,dc=org
objectclass: top
objectclass: person
objectclass: organizationalPerson
objectclass: inetOrgPerson
cn: Space Cadet
sn: Cadet
uid: space cadet
userPassword: spacecadetspassword



dn: cn=developers,ou=groups,dc=springframework,dc=org
objectclass: top
objectclass: groupOfUniqueNames
cn: developers
ou: developer
uniqueMember: uid=ben,ou=people,dc=springframework,dc=org
uniqueMember: uid=bob,ou=people,dc=springframework,dc=org

dn: cn=managers,ou=groups,dc=springframework,dc=org
objectclass: top
objectclass: groupOfUniqueNames
cn: managers
ou: manager
uniqueMember: uid=ben,ou=people,dc=springframework,dc=org
uniqueMember: cn=mouse\, jerry,ou=people,dc=springframework,dc=org

dn: cn=submanagers,ou=subgroups,ou=groups,dc=springframework,dc=org
objectclass: top
objectclass: groupOfUniqueNames
cn: submanagers
ou: submanager
uniqueMember: uid=ben,ou=people,dc=springframework,dc=org

#Based on the LDIF file, here is a basic overview of the springframework domain:
#
#**Domain Name**: springframework
#
#**Organizational Units (OUs)**:
#
#* people
#* groups
#* space cadets
#* otherpeople
#* quoted people
#
#**Groups**:
#
#* developers (contains ben and bob)
#* managers (contains ben and jerry)
#* submanagers (contains ben)
#
#**Users**:
#
#* ben (uid=ben, ou=people)
#* bob (uid=bob, ou=people)
#* joe (uid=joe, ou=otherpeople)
#* jerry (uid=jerry, ou=people)
#* slashguy (uid=slashguy, ou=people)
#* quoteguy (uid=quoteguy, ou="quoted people")
#* space cadet (uid=space cadet, ou=space cadets)
#
#**Domain Structure**:
#
#* The domain is divided into several OUs, including people, groups, space cadets, otherpeople, and quoted people.
#* The people OU contains several users, including ben, bob, jerry, slashguy, and others.
#* The groups OU contains several groups, including developers, managers, and submanagers.
#* The space cadets OU contains a single user, space cadet.
#* The otherpeople OU contains a single user, joe.
#* The quoted people OU contains a single user, quoteguy.